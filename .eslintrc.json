{
  "extends": [
    "../.eslintrc.json",
    "plugin:react/recommended",
    "plugin:jsx-a11y/recommended",
    "plugin:react-hooks/recommended"
  ],
  "env": {
    "browser": true
  },
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react", "jsx-a11y", "react-hooks"],
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
